{
  "name": "tako-sen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "dev:all": "node scripts/dev.mjs",
    "dev:roji": "roji run tako-sen -- node scripts/dev.mjs",
    "dev:roji:bypass": "roji run tako-sen -- node scripts/dev.mjs --bypass",
    "dev:all:bypass": "node scripts/dev.mjs --bypass",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:audit": "vitest run --mode audit tests/generator-audit.test.ts",
    "test:full": "vitest run --mode audit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/vue": "^2.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.4.0",
    "wrangler": "^4.140.0"
  }
}
