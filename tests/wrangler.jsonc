{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The Worker's tests (vitest.config.ts, project "worker"). The entry is the
  // real one, so `exports.default` and GameService are the deployed Worker's.
  "name": "tako-test",
  "main": "../src/worker/main.ts",
  "compatibility_date": "2026-09-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tako-test",
      // Local only: never a real database.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  // The ID platform's dev values. ID_PUBLIC_KEYS accepts no cookie: a test
  // that signs requests passes its own keys (tests/worker-env.ts).
  "vars": {
    "ID_COOKIE_NAME": "__Secure-kgdev_id",
    "ID_ISSUER": "dev.kan-game.app",
    "ID_PUBLIC_KEYS": "[]",
    "ALLOWED_ORIGINS": "https://tako-dev.kan-game.app",
    // A secret in every deployed environment; a known value here.
    "DAILY_SEED_SECRET": "test-secret",
  },
}
