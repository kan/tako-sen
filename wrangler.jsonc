{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is for local development (`npm run dev:roji`). The old URL,
  // tako-sen.kan-fushihara.workers.dev, deploys from the legacy-clerk branch.
  "name": "tako-local",
  "compatibility_date": "2026-09-15",
  "main": "./src/worker/main.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tako-local",
      "migrations_dir": "migrations",
    },
  ],
  // The kan-game.app ID platform (kan/game). /api/id/* is passed to it, and
  // names are registered through its RPC (src/worker/id-rpc.ts).
  "services": [{ "binding": "ID", "service": "kan-game-local" }],
  // 23:00 in Japan: builds the next day's daily board an hour before it opens.
  // 0:05: tells subscribed devices it has opened (src/worker/push.ts, which
  // knows the second by its expression: keep both in every environment).
  "triggers": { "crons": ["0 14 * * *", "5 15 * * *"] },
  "vars": {
    // The ID cookie and the keys that verify it (kan/game docs/ID_DESIGN.md
    // 「ID と Cookie」). Locally the keys are kan/game's own (its .dev.vars),
    // which scripts/dev.mjs passes in.
    "ID_COOKIE_NAME": "__Secure-kgdev_id",
    "ID_ISSUER": "localhost",
    "ID_PUBLIC_KEYS": "[]",
    // Web Push (scripts/generate-vapid-keys.ts), one key pair per environment.
    // Locally push stays off until VAPID_PRIVATE_KEY is in .dev.vars.
    "VAPID_PUBLIC_KEY": "BBchosiFIPF4nqIPVsI3dZH4B_N_Nf6-vs9oYCTk81C-ze5VRWR9ZxhUIkcEbn4yQMGb2g8Y3ExXZKgfNYeutwQ",
    "VAPID_SUBJECT": "https://kan-game.app",
  },
  "secrets": {
    "required": ["ALLOWED_ORIGINS"],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "env": {
    // The development environment of main (docs/NEXT_PHASE.md「本番リリース
    // 計画」): `npx wrangler deploy --env dev`.
    "dev": {
      "name": "tako-dev",
      "routes": [{ "pattern": "tako-dev.kan-game.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tako-dev",
          "database_id": "a9693f19-aece-40d6-8b3c-d5a2c2222bb1",
          "migrations_dir": "migrations",
        },
      ],
      // kan/game's development Worker, which calls back GameService
      // (src/worker/game-service.ts) when a player withdraws.
      "services": [{ "binding": "ID", "service": "kan-game-dev" }],
      "triggers": { "crons": ["0 14 * * *", "5 15 * * *"] },
      "vars": {
        // Must match kan/game's env.dev (its wrangler.jsonc).
        "ID_COOKIE_NAME": "__Secure-kgdev_id",
        "ID_ISSUER": "dev.kan-game.app",
        // JSON array of public JWKs, each with kid. To rotate, follow
        // kan/game docs/ID_DESIGN.md「鍵の管理」 and copy its new list here.
        "ID_PUBLIC_KEYS": "[{\"kid\":\"2026-10-18-2515ed\",\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"0KpEL8A2l9DupwZ2uVJVr_ZGy-sRbGJcJg-2Wwi8McU\",\"y\":\"yMVIO135BT3klr-T0Xtr4cRkdkAvfkwxAMaTzoH5EC4\"}]",
        // Not a secret here: the deployed origin is public.
        "ALLOWED_ORIGINS": "https://tako-dev.kan-game.app",
        "VAPID_PUBLIC_KEY": "BPA7S87ONByvgig1y_amEQIDxUA2zThYdSbYMpi8EbCyi7M1mwxQiU3P0zJDu0e-B181GcQ8POYKUI5FLM3zqpc",
        "VAPID_SUBJECT": "https://kan-game.app",
      },
      // Not inherited from the top level.
      "secrets": { "required": ["VAPID_PRIVATE_KEY"] },
    },
    // Production (docs/DEPLOY_PROD.md): `npx wrangler deploy --env production`.
    "production": {
      "name": "tako",
      "routes": [{ "pattern": "tako.kan-game.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tako-prod",
          "database_id": "fe401d20-1851-4085-9340-b14058a2e438",
          "migrations_dir": "migrations",
        },
      ],
      // kan/game's production Worker, which calls back GameService when a
      // player withdraws.
      "services": [{ "binding": "ID", "service": "kan-game" }],
      "triggers": { "crons": ["0 14 * * *", "5 15 * * *"] },
      "vars": {
        // Must match kan/game's env.production (its wrangler.jsonc).
        "ID_COOKIE_NAME": "__Secure-kg_id",
        "ID_ISSUER": "kan-game.app",
        // JSON array of public JWKs, each with kid. To rotate, follow
        // kan/game docs/ID_DESIGN.md「鍵の管理」 and copy its new list here.
        "ID_PUBLIC_KEYS": "[{\"kid\":\"2026-10-18-ccfc63\",\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"ddT7jKLdotzN141EdW32MjeKrySOCqm_OGKRbA27NBY\",\"y\":\"UR7l_tKX9mUzRzJElH_IFWQ36a0PggvU803FVXI_yqk\"}]",
        "ALLOWED_ORIGINS": "https://tako.kan-game.app",
        "VAPID_PUBLIC_KEY": "BA7Uz9g26veZhYMAJFdv8zqE1KjubVJuguV3-h1uc-m-4j-YS9EVa1F-0oK_TrAqWpGuO80wD9GVoGkuiCwbiYA",
        "VAPID_SUBJECT": "https://kan-game.app",
      },
      "secrets": { "required": ["VAPID_PRIVATE_KEY"] },
    },
  },
}
