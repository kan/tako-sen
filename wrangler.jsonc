{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tako-sen",
  "compatibility_date": "2026-09-15",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tako-sen-dev",
      "database_id": "0030813b-7c99-403d-b33b-85fd632ebf65",
      "migrations_dir": "migrations",
    },
  ],
  // 23:00 in Japan: builds the next day's daily board an hour before it opens.
  "triggers": { "crons": ["0 14 * * *"] },
  // The move to kan-game.app (src/worker/moved.ts). Empty while the old URL
  // runs the game; at the switch (R4), the new origin and the last day of the
  // migration period, e.g. "https://tako.kan-game.app" and "2027-01-31".
  "vars": {
    "MOVED_TO": "",
    "MIGRATION_ENDS": "",
  },
  "secrets": {
    "required": [
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "ALLOWED_ORIGINS",
    ],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
